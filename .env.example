# Servis sozlamalari
SERVICE_NAME=sale-service
VERSION=1.0.0
ENVIRONMENT=development

# HTTP sozlamalari
HTTP_PORT=:8080

# gRPC sozlamalari
GRPC_PORT=:50051

# PostgreSQL sozlamalari
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=1234
DATABASE_NAME=sale_db
DATABASE_SSLMODE=disable

# Redis sozlamalari
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka sozlamalari
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=product-events
KAFKA_GROUP_ID=sale-service-group

# Logger sozlamalari
LOGGER_LEVEL=debug
LOGGER_FILE_PATH=./logs/app.log